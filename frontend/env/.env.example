# ============================================================
# e-Samsat Aceh — Konfigurasi Environment (Frontend)
# Referensi: API-Specification-esamsat_acehprov_go_id.md
# ============================================================
# Salin file ini menjadi .env dan isi nilainya sesuai kebutuhan.

# ─── API Backend ────────────────────────────────────────────
# Base URL untuk semua endpoint API (Inquiry, Kode Bayar, dll)
VITE_API_URL=https://api.samsatdigital.net

# ─── SSE (Server-Sent Events) ──────────────────────────────
# Base URL untuk notifikasi pembayaran real-time via SSE
VITE_SSE_URL=https://notify.samsatdigital.net/sse/streams

# ─── Aplikasi ──────────────────────────────────────────────
# Base path untuk deployment (contoh: /esamsat-remodel/ untuk GitHub Pages)
VITE_BASE_PATH=/esamsat-remodel/

# Nama aplikasi
VITE_APP_TITLE=e-Samsat Aceh

# ─── Environment Flag ─────────────────────────────────────
# Digunakan oleh file konstanta (src/constants/env.js)
# Nilai: 'development' atau 'production'
VITE_APP_ENV=development
